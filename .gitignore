target/
# Any scratch target dir — agents run parallel builds into their own, and one
# that lands inside the source tree gets swept into a commit. 7 GB of build
# artifacts reached HEAD that way once.
target-*/
dist/
node_modules/
.DS_Store
.direnv/
.claude/worktrees/

# Staged web bundles embedded into the native binaries (just web-stage,
# just patchbay-web-stage)
apps/session/desktop/web-dist/
apps/studio/desktop/web-dist/
apps/patchbay/web-dist/

# graphify knowledge graph — regenerable via `just graph`, machine-local.
# Un-ignore graph.json/GRAPH_REPORT.md if you want to share a prebuilt graph.
graphify-out/

# nix build result symlinks (result, result-1, result-2, ...)
result
result-*

# Symlink to the resolved lumen-blocks checkout, created by `just tailwind`
# so Tailwind scans the pinned revision instead of every cached one.
apps/session/desktop/.lumen-blocks
apps/studio/desktop/.lumen-blocks
features/ui/.architect-ui

# local reference checkouts (upstream scripts we port from)
.reference/

# Local credentials (the TONE3000 keys — features/signal/docs/tone3000.md),
# sourced by the default dev shell.
# `.env` holds real values and is never committed.
.env

# Stray cargo target directories.
#
# `/target` covers the workspace's own, but a `cargo` run with CARGO_TARGET_DIR
# set inside a crate leaves one wherever it was pointed — and 7.6 GB of .rlib
# files once made it into a commit, which GitHub then refused to accept (its
# limit is 100 MB per file). Anything named like a target directory is build
# output no matter where it turns up.
target-*/
**/target/

# Local render/scoring scratch (CSS A/B renders are hundreds of MB).
scratch/
__pycache__/

# Generated by the orchestra css-ab harness (gen_css_ab writes to CWD)
css_ab*.mid
css_ab*.wav
css_ab*.tsv

# Alternate target dir used by the old gate.sh helper
/target-local

# apps/session/web's compiled Tailwind sheet (just web-tailwind) and its
# resolved-git-dep symlinks (architect-ui has no stable path on disk) —
# both regenerable, same shape as keyflow's apps/session/web/.tailwind-src.
apps/session/web/assets/tailwind.css
apps/session/web/.tailwind-src/

# The golden session's synthetic media: generated by `just daw-template`, never
# committed — the project text beside it is the fixture.
features/dynamic-template/fixtures/golden/media/

# Large binaries linked in by `just assets` (see assets.txt)
/.assets/
