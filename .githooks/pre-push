#!/usr/bin/env bash
set -euo pipefail

# Pre-push: run local CI (scripts/ci-local.sh: fmt, change files, and the
# tests / cargo check / wasm check that `cargo rail plan` says the change
# affects) on this machine's warm target dir, and once the push lands mark
# every pushed commit with the `local-ci` status. That status is a required
# check on main: PRs run only the free hosted checks, so this is where the
# build and the tests gate a PR (checks.yml). The same hook as Task's.
#
# It checks the CHECKED-OUT tree, so it vouches only for pushed commits that
# tree contains: HEAD and its ancestors (a stack pushed from its top). A
# pushed branch HEAD doesn't contain, or a dirty tree, gets no status; push
# it from its own checkout, or run the full set on GitHub instead:
#
#   gh workflow run checks.yml --ref <branch>     (posts local-ci when green)
#
# Skip switch: `NO_LOCAL_CI=1 git push …` pushes without checking. The PR
# then waits on `local-ci` until a checked push or a dispatched run marks it.
#
# Pushes queue on one lock per clone (where flock exists), so parallel
# agents don't each build the workspace at once.

if [ "${NO_LOCAL_CI:-0}" = "1" ]; then
  echo >&2 "pre-push: NO_LOCAL_CI=1, not checked; the PR's local-ci check stays pending."
  exit 0
fi

zero="0000000000000000000000000000000000000000"
head="$(git rev-parse HEAD)"
covered=()
uncovered=()
while read -r _lref lsha rref _rsha; do
  [ "$lsha" = "$zero" ] && continue # a branch delete
  case "$rref" in refs/heads/*) ;; *) continue ;; esac # tags
  if git merge-base --is-ancestor "$lsha" "$head" 2>/dev/null; then
    covered+=("$lsha")
  else
    uncovered+=("${rref#refs/heads/}")
  fi
done

if [ "${#uncovered[@]}" -gt 0 ]; then
  echo >&2 "pre-push: not in the checked-out tree, so no local-ci for: ${uncovered[*]}"
fi
[ "${#covered[@]}" -gt 0 ] || exit 0

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo >&2 "pre-push: uncommitted changes, so a green run would not prove the pushed commits."
  echo >&2 "          Pushing without local-ci; commit them and push again to get it."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMON_DIR="$(cd "$(git rev-parse --git-common-dir)" && pwd)"

if command -v flock >/dev/null 2>&1; then
  exec 9>"$COMMON_DIR/ci-local.lock"
  flock -n 9 || { echo >&2 "pre-push: another push's local CI is running; waiting…"; flock 9; }
fi

# ci-local needs the dev shell (cargo-rail, nextest, tailwindcss, the native
# headers). Already in it when cargo-rail is on PATH; otherwise enter .#ci.
if command -v cargo-rail >/dev/null 2>&1 || ! command -v nix >/dev/null 2>&1; then
  bash "$REPO_ROOT/scripts/ci-local.sh"
else
  nix develop --accept-flake-config "$REPO_ROOT#ci" -c bash "$REPO_ROOT/scripts/ci-local.sh"
fi

log="$COMMON_DIR/ci-local.log"
nohup bash "$REPO_ROOT/scripts/ci-local.sh" --post "${covered[@]}" >>"$log" 2>&1 </dev/null &
echo >&2 "pre-push: green; local-ci goes to ${#covered[@]} commit(s) once GitHub has them (log: $log)"
