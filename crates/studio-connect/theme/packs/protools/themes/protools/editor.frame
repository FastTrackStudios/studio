<Document>
  <!-- The MIDI editor: a grey tool bar with grey buttons (blue when on)
       and black counters in green; a blue-grey ruler with white bar
       numbers; a light keyboard whose black keys carry their names; the
       light note area the view draws; a light velocity lane with its name
       on a dark column; dark menus. -->
  <Page name="editor.bar">
    <Frame name="Bar" w=1200 h=30>
      <Rectangle name="Ground" w=1200 h=30 bind:w="w" bind:h="h" bind:fill="$editor.surface_bar" />
      <Rectangle name="Sheen" w=1200 h=1 bind:w="w" bind:fill="$sheen" />
      <Rectangle name="Rule" y=29 w=1200 h=1 bind:y="h - 1" bind:w="w" bind:fill="$editor.border_strong" />
    </Frame>
  </Page>
  <Page name="editor.button">
    <Frame name="Button" w=80 h=24>
      <!-- a counter: black, green figures -->
      <Rectangle name="Readout" w=80 h=24 radius=2 bind:w="w" bind:h="h" bind:visible="button.readout" bind:fill="$local.readout" />
      <Rectangle name="Readout edge" x=0.5 y=0.5 w=79 h=23 radius=2 stroke-weight=1 stroke-align="center" bind:w="w - 1" bind:h="h - 1" bind:visible="button.readout" bind:stroke="$editor.border_strong" />
      <!-- a button: grey, blue when on -->
      <Rectangle name="Face" w=80 h=24 radius=2 bind:w="w" bind:h="h" bind:visible="!button.readout" bind:fill="button.on ? $editor.control_active : (button.pressed ? darken($editor.control, 0.15) : (button.hover ? $editor.control_hover : $editor.control))" />
      <Rectangle name="Sheen" x=1 y=1 w=78 h=1 bind:w="w - 2" bind:visible="!button.readout" bind:fill="$sheen" />
      <Rectangle name="Outline" x=0.5 y=0.5 w=79 h=23 radius=2 stroke-weight=1 stroke-align="center" bind:w="w - 1" bind:h="h - 1" bind:visible="!button.readout" bind:stroke="$hardware.edge" />
      <Text name="Label" w=80 h=14 size=10 weight=700 text-align="center" bind:w="w" bind:y="h / 2 - 6.5" bind:size="button.label_size" bind:text="button.label" bind:fill="!button.enabled ? $editor.text_faint : (button.readout ? $local.readout_ink : $local.button_ink)">Button</Text>
    </Frame>
  </Page>
  <Page name="editor.keys">
    <Frame name="Keys" w=54 h=400>
      <Rectangle name="Bed" w=54 h=400 bind:w="w" bind:h="h" bind:fill="key.piano ? $editor.key_white : $editor.gutter_bg" />
      <Rectangle name="Edge" x=53 w=1 h=400 bind:x="w - 1" bind:h="h" bind:fill="$editor.border_strong" />
    </Frame>
  </Page>
  <Page name="editor.key">
    <Frame name="Key" w=54 h=12>
      <!-- a drum lane's key: a flat band -->
      <Rectangle name="Lane" w=53 h=12 bind:w="w - 1" bind:h="h" bind:visible="!key.piano" bind:fill="key.black ? $editor.key_black : $editor.key_white" />
      <!-- a black key: dark, three fifths of the width, its name on it -->
      <Rectangle name="Black" w=33 h=12 radius=1 bind:w="(w - 1) * 0.62" bind:h="h" bind:visible="key.piano && key.black" bind:fill="$editor.key_black" />
      <Rectangle name="Shine" x=1 w=31 h=1 bind:w="(w - 1) * 0.62 - 2" bind:y="1" bind:visible="key.piano && key.black" fill="#ffffff22" />
      <Rectangle name="Part" w=53 h=1 bind:w="w - 1" bind:visible="!(key.piano && key.black)" fill="#00000040" />
      <Text name="Name" x=3 w=46 h=12 size=9 weight=600 bind:y="h / 2 - 5.5" bind:visible="key.labelled" bind:text="key.label" bind:fill="key.piano && key.black ? #e6e6e6 : $editor.key_label">C4</Text>
    </Frame>
  </Page>
  <Page name="editor.keygroup">
    <Frame name="Group" w=54 h=24>
      <Rectangle name="Ground" w=54 h=24 bind:w="w" bind:h="h" bind:fill="$editor.gutter_bg" />
      <Rectangle name="Brace" x=2 y=2 w=2 h=20 bind:h="h - 4" bind:fill="$editor.accent" />
      <Text name="Name" x=7 w=46 h=12 size=9 weight=700 bind:y="h / 2 - 5.5" bind:text="group.label" bind:fill="$editor.text">T1</Text>
    </Frame>
  </Page>
  <Page name="editor.lane">
    <!-- A take's header over the gutter: a bar down the take being
         edited, its name, and a mark on the reference take. -->
    <Frame name="Lane" w=54 h=120>
      <Rectangle name="Bar" w=4 h=120 bind:h="h" bind:visible="lane.active" bind:fill="lane.tinted ? lane.tint : $editor.accent" />
      <Rectangle name="Edge" x=53 w=1 h=120 bind:x="w - 1" bind:h="h" bind:fill="$editor.border_strong" />
      <Rectangle name="Plate" x=7 y=4 w=44 h=14 radius=1 bind:w="w - 10" bind:fill="lane.active ? $local.name_selected : $local.name" />
      <Text name="Name" x=9 y=5 w=42 h=12 size=9 weight=700 bind:w="w - 12" bind:text="lane.name" bind:fill="lane.active ? $local.plate_selected_ink : $local.name_ink">Main</Text>
      <Rectangle name="Reference" x=7 y=22 w=26 h=12 radius=2 bind:visible="lane.reference" bind:fill="$editor.gold" />
      <Text name="Ref" x=7 y=22 w=26 h=12 size=7 weight=700 text-align="center" bind:visible="lane.reference" fill="#141414">REF</Text>
    </Frame>
  </Page>
  <Page name="editor.ruler">
    <Frame name="Ruler" w=1200 h=28>
      <Rectangle name="Ground" w=1200 h=28 bind:w="w" bind:h="h" bind:fill="$local.editor_ruler" />
      <Rectangle name="Rule" y=27 w=1200 h=1 bind:y="h - 1" bind:w="w" bind:fill="$editor.border_strong" />
      <Rectangle name="Gutter" w=54 h=28 bind:h="h" bind:fill="$local.editor_ruler_label" />
      <Text name="Kind" x=4 w=50 h=12 size=9 weight=700 bind:y="h / 2 - 6" fill="#ffffff">Bars|Beats</Text>
      <Rectangle name="Gutter edge" x=53 w=1 h=28 bind:h="h" bind:fill="$editor.border_strong" />
    </Frame>
  </Page>
  <Page name="editor.tick">
    <Frame name="Tick" w=60 h=28>
      <Rectangle name="Line" w=1 h=22 bind:y="tick.bar ? 4 : h - 6" bind:h="tick.bar ? h - 4 : 6" bind:fill="tick.bar ? #ffffffb0 : #ffffff55" />
      <Text name="Number" x=4 y=3 w=54 h=12 size=10 weight=700 bind:visible="tick.labelled" bind:text="tick.label" fill="#ffffff">1</Text>
    </Frame>
  </Page>
  <Page name="editor.marker">
    <Frame name="Marker" w=160 h=28>
      <Vector name="Flag" y=1 w=9 h=9 geometry="M 0 0 L 9 0 L 9 6 L 4.5 9 L 0 6 Z" bind:fill="$editor.gold" />
      <Text name="Name" x=11 w=148 h=12 size=9 weight=700 bind:y="0" bind:text="marker.label" bind:fill="$editor.gold">Verse</Text>
    </Frame>
  </Page>
  <Page name="editor.strip">
    <!-- The velocity and controller lane: light, its name in a selector on
         a dark column, guides at a quarter, a half, three quarters. -->
    <Frame name="Strip" w=1200 h=96>
      <Rectangle name="Ground" w=1200 h=96 bind:w="w" bind:h="h" bind:fill="$local.editor_lane" />
      <Rectangle name="Top rule" w=1200 h=2 bind:w="w" bind:fill="$editor.border_strong" />
      <Rectangle name="Gutter" w=54 h=96 bind:h="h" bind:fill="$local.editor_lane_label" />
      <Rectangle name="Gutter edge" x=53 w=1 h=96 bind:h="h" bind:fill="$editor.border_strong" />
      <Rectangle name="Selector" x=3 y=6 w=48 h=15 radius=2 bind:fill="$local.dropdown" />
      <Rectangle name="Selector outline" x=3.5 y=6.5 w=47 h=14 radius=2 stroke-weight=1 stroke-align="center" bind:stroke="$hardware.edge" />
      <Text name="Lane" x=5 y=8 w=38 h=12 size=8 weight=700 bind:text="strip.label" bind:fill="$local.dropdown_ink">velocity</Text>
      <Vector name="Caret" x=43 y=12 w=6 h=4 geometry="M 0 0 L 6 0 L 3 4 Z" bind:fill="$local.dropdown_ink" />
      <Rectangle name="Quarter" x=54 y=72 w=1146 h=1 bind:y="h * 0.75" bind:w="w - 54" fill="#00000018" />
      <Rectangle name="Half" x=54 y=48 w=1146 h=1 bind:y="h * 0.5" bind:w="w - 54" fill="#00000030" />
      <Rectangle name="Three quarters" x=54 y=24 w=1146 h=1 bind:y="h * 0.25" bind:w="w - 54" fill="#00000018" />
    </Frame>
  </Page>
  <Page name="editor.menu">
    <Frame name="Menu" w=220 h=200>
      <Rectangle name="Shadow" x=0 y=3 w=220 h=200 radius=6 bind:w="w" bind:h="h" fill="#00000066" />
      <Rectangle name="Panel" w=220 h=200 radius=6 bind:w="w" bind:h="h" bind:fill="$local.menu" />
      <Rectangle name="Edge" x=0.5 y=0.5 w=219 h=199 radius=6 stroke-weight=1 stroke-align="center" bind:w="w - 1" bind:h="h - 1" fill="#00000000" stroke="#ffffff1f" />
    </Frame>
  </Page>
  <Page name="editor.menuitem">
    <Frame name="Item" w=220 h=22>
      <Rectangle name="Rule" x=8 y=-2 w=204 h=1 bind:w="w - 16" bind:visible="menu.rule" fill="#ffffff26" />
      <Rectangle name="Hover" x=4 w=212 h=22 radius=4 bind:w="w - 8" bind:h="h" bind:visible="menu.hover && menu.enabled" bind:fill="$editor.control_active" />
      <Text name="Label" x=14 w=150 h=14 size=11 bind:y="h / 2 - 7" bind:text="menu.label" bind:fill="menu.enabled ? #f2f2f2 : #8a8a8a">Quantize</Text>
      <Text name="Key" x=150 w=60 h=14 size=10 text-align="right" bind:x="w - 72" bind:y="h / 2 - 6.5" bind:text="menu.shortcut" bind:fill="menu.enabled ? #b8b8b8 : #6a6a6a">Q</Text>
    </Frame>
  </Page>
</Document>
