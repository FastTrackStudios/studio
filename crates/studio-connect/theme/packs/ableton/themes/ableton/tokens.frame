<Document>
  <!-- Two modes of one look. `light` is the mid-grey one; `dark` keeps the
       same hues and controls on dark greys. Every colour the views paint
       natively (the arrangement, the rack, the rails) and every colour the
       pages below draw comes from here; `local.*` are this pack's own. -->
  <Variables modes="dark light">
    <!-- ink: black glyphs on the light greys, light ones on the dark -->
    <Var name="text" dark="#d4d4d4" light="#000000" />
    <Var name="text.dim" dark="#9a9a9a" light="#545454" />
    <Var name="text.faint" dark="#6e6e6e" light="#6e6e6e" />
    <Var name="text.bright" dark="#f2f2f2" light="#000000" />
    <Var name="accent" dark="#ffb100" light="#ffb100" />
    <Var name="selected" dark="#0b7d91" light="#096879" />
    <!-- surfaces: one ladder, a step apart, every edge one dark pixel -->
    <Var name="surface" dark="#2a2a2a" light="#7f7f7f" />
    <Var name="surface.raised" dark="#383838" light="#8d8d8d" />
    <Var name="surface.sunken" dark="#1e1e1e" light="#646464" />
    <Var name="border" dark="#121212" light="#4e4e4e" />
    <Var name="hardware" dark="#4a4a4a" light="#b7b7b7" />
    <Var name="hardware.edge" dark="#141414" light="#404040" />
    <Var name="hardware.mark" dark="#dcdcdc" light="#000000" />
    <Var name="plate" dark="#1e1e1e" light="#646464" />
    <Var name="sheen" dark="#ffffff00" light="#ffffff00" />
    <Var name="field" dark="#555555" light="#dadada" />
    <Var name="combo" dark="#555555" light="#dad9d9" />
    <!-- states. The activator is lit (amber) while the track plays, so a
         muted track is the grey one: `mute` is the activator switched off. -->
    <Var name="mute" dark="#5c5c5c" light="#dcdcdc" />
    <Var name="solo" dark="#3873ff" light="#3873ff" />
    <Var name="rec" dark="#ff563f" light="#ff563f" />
    <Var name="pan" dark="#53dcf4" light="#53dcf4" />
    <Var name="monitor.tape" dark="#53dcf4" light="#53dcf4" />
    <Var name="route.out" dark="#53dcf4" light="#096879" />
    <Var name="route.send" dark="#ffb100" light="#b27c00" />
    <Var name="route.recv" dark="#ff563f" light="#c63a26" />
    <!-- meters: green, yellow at the top, red over -->
    <Var name="meter.safe" dark="#4fd843" light="#59e44b" />
    <Var name="meter.warn" dark="#f2f22a" light="#ffff08" />
    <Var name="meter.danger" dark="#ff2200" light="#ff2200" />
    <Var name="meter.well" dark="#181818" light="#242424" />
    <!-- the track panel and the rails -->
    <Var name="tcp.tint" dark="#363636" light="#b6b6b6" />
    <Var name="tcp.column" dark="#2e2e2e" light="#adadad" />
    <Var name="rail.ground" dark="#2a2a2a" light="#7f7f7f" />
    <Var name="rail.rule" dark="#121212" light="#4e4e4e" />
    <Var name="rail.button" dark="#4a4a4a" light="#b7b7b7" />
    <Var name="rack.well" dark="#1e1e1e" light="#646464" />
    <Var name="tint.strength" value="0.04" />
    <!-- the arrangement -->
    <Var name="arrange.ground" dark="#262626" light="#a8a8a8" />
    <Var name="arrange.row" dark="#303030" light="#b6b6b6" />
    <Var name="arrange.row_alt" dark="#2c2c2c" light="#adadad" />
    <Var name="arrange.divider" dark="#1c1c1c" light="#a6a6a6" />
    <Var name="grid.bar" dark="#454545" light="#a09d9d" />
    <Var name="grid.beat" dark="#393939" light="#a09d9d" />
    <Var name="grid.sub" dark="#333333" light="#a6a4a4" />
    <Var name="ruler.ground" dark="#303030" light="#a8a8a8" />
    <Var name="ruler.ink" dark="#d4d4d4" light="#000000" />
    <Var name="ruler.ink_dim" dark="#7c7c7c" light="#545454" />
    <Var name="playhead" dark="#f2f2f2" light="#000000" />
    <Var name="cursor.edit" dark="#ff3a3a" light="#dd0000" />
    <Var name="clip.edge" dark="#101010" light="#4e4e4e" />
    <Var name="clip.alpha" dark="0.62" light="0.7" />
    <!-- The clip palette: sixteen fixed hues. A track's own colour snaps to
         the nearest, on its clips, its header and its strip. -->
    <Var name="clip.0" value="#e2725b" />
    <Var name="clip.1" value="#ee9a45" />
    <Var name="clip.2" value="#e6c64c" />
    <Var name="clip.3" value="#b5d05e" />
    <Var name="clip.4" value="#6cc26c" />
    <Var name="clip.5" value="#4fbe9b" />
    <Var name="clip.6" value="#52b6cf" />
    <Var name="clip.7" value="#5f9ddc" />
    <Var name="clip.8" value="#8086dc" />
    <Var name="clip.9" value="#a67fdc" />
    <Var name="clip.10" value="#cf7fd0" />
    <Var name="clip.11" value="#e27fa2" />
    <Var name="clip.12" value="#c49a6c" />
    <Var name="clip.13" value="#9db09e" />
    <Var name="clip.14" value="#98a6b8" />
    <Var name="clip.15" value="#bdbdbd" />
    <!-- sizes and type: compact, bold -->
    <Var name="radius.control" value="0" />
    <Var name="size.label" value="11" />
    <Var name="size.small" value="9" />
    <Var name="font.ui" value="\"Inter\"" />
    <!-- this pack's own -->
    <Var name="local.strip" dark="#333333" light="#8d8d8d" />
    <Var name="local.strip_selected" dark="#424242" light="#a8a8a8" />
    <Var name="local.button" dark="#4a4a4a" light="#b7b7b7" />
    <Var name="local.button_hover" dark="#555555" light="#c4c4c4" />
    <Var name="local.glyph" dark="#dcdcdc" light="#000000" />
    <Var name="local.active" dark="#ffb100" light="#ffb100" />
    <Var name="local.lit_glyph" value="#000000" />
    <Var name="local.slider" dark="#53dcf4" light="#53dcf4" />
    <Var name="local.knob_track" dark="#141414" light="#171717" />
    <Var name="local.fader" dark="#e0e0e0" light="#000000" />
    <Var name="local.title_ink" value="#000000" />
  </Variables>
</Document>
