{
  "name": "@fts/figma-import",
  "version": "0.1.0",
  "private": true,
  "description": "Figma exporter plugin for Frame/AnyRender ingestion",
  "main": "code.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "pnpm build --watch",
    "bridge": "node ./scripts/local-bridge.mjs",
    "bridge:watch": "node --watch ./scripts/local-bridge.mjs",
    "lint": "eslint --ext .ts --ignore-pattern node_modules .",
    "lint:fix": "eslint --ext .ts --ignore-pattern node_modules --fix ."
  },
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "1.123.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@figma/figma-plugins/dynamic-page-documentchange-event-advice": "off",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
