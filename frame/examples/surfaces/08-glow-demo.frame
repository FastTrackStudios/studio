          <Vector name="scale arc" w=216 h=144 stroke="#2a2418" stroke-weight=1.2 geometry="M 38 86 A 92 92 0 0 1 178 86" />
          <Vector name="red zone" w=216 h=144 fill="#c0301f" geometry="M 150.0 60.0 A 92 92 0 0 1 178.0 86.0 L 174.0 89.0 A 87 87 0 0 0 147.5 64.5 Z" />
