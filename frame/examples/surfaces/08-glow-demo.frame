<Document>
  <Page name="Surface">
    <Frame name="Glow Demo" w=720 h=300 radius=6 clip fill={[{"kind": {"LinearGradient": {"stops": [{"position": 0, "color": "#1c1c20"}, {"position": 1, "color": "#111114"}]}}}]}>
