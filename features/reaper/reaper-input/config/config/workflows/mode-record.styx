// Record mode workflow. id = "mode-record", name = "Mode Record".
//
// Take ranking bindings for comping workflow. Three scopes:
//   - 1/2/3/0       → set rank at (play position - 2s) or edit cursor
//                     if not playing, on every selected item.
//   - <S-1/2/3/0>   → set rank item-wide on every selected item
//                     (marker placed at item start).
//   - f / b         → favorite / down-rank on the take under the mouse,
//                     marker placed at the mouse's project-time position.
//
// Action IDs use REAPER's named-command form (`_FTS_SESSION_*`) so they
// resolve via `named_command_lookup`. They're registered by the session
// crate (see session::take_ranking) and emit one undo block per press.

name        "Record"
description "Tracking, takes, monitoring."

bindings (
    // ── Play-position-minus-2s scope ──
    {keys "1", action "_FTS_SESSION_TAKE_RANK_PLAYPOS_1",    desc "Rank :) (play-pos -2s)"}
    {keys "2", action "_FTS_SESSION_TAKE_RANK_PLAYPOS_2",    desc "Rank :)) (play-pos -2s)"}
    {keys "3", action "_FTS_SESSION_TAKE_RANK_PLAYPOS_3",    desc "Rank :))) (play-pos -2s)"}
    {keys "0", action "_FTS_SESSION_TAKE_RANK_PLAYPOS_DOWN", desc "Down-rank (play-pos -2s)"}

    // ── Item-wide scope ──
    {keys "<S-1>", action "_FTS_SESSION_TAKE_RANK_ITEM_1",    desc "Rank :) (item-wide)"}
    {keys "<S-2>", action "_FTS_SESSION_TAKE_RANK_ITEM_2",    desc "Rank :)) (item-wide)"}
    {keys "<S-3>", action "_FTS_SESSION_TAKE_RANK_ITEM_3",    desc "Rank :))) (item-wide)"}
    {keys "<S-0>", action "_FTS_SESSION_TAKE_RANK_ITEM_DOWN", desc "Down-rank (item-wide)"}

    // ── Mouse-position scope ──
    {keys "f", action "_FTS_SESSION_TAKE_RANK_MOUSE_1",    desc "Favorite take at mouse"}
    {keys "b", action "_FTS_SESSION_TAKE_RANK_MOUSE_DOWN", desc "Down-rank take at mouse"}

    // ── Transport / tracking ─────────────────────────────────────────
    // `m` (markers) stays inherited from the base profile.
    {keys "r",     action 1013,                       desc "Transport: Record"}
    {keys "<A-r>", action 9,                          desc "Toggle record arm on selected tracks"}
    {keys "i",     action "_FTS_SESSION_MONITOR_TOGGLE_ON_OFF",   desc "Toggle record monitor on/off (skip auto/tape)"}
    {keys "<S-i>", action "_FTS_SESSION_MONITOR_TOGGLE_TAPE_OFF", desc "Toggle record monitor auto/tape ↔ off"}
    {keys "p",     action 41819,                      desc "Toggle pre-roll on record"}
    {keys "e",     action "_FTS_SESSION_RECORD_RESTART", desc "Restart recording (delete bad take + re-record)"}
)
