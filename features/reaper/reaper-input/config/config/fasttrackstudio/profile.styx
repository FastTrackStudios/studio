name FastTrackStudio
description "FastTrackStudio — vim-inspired keybindings optimised for production workflows"
version 1.0.0

/// Section files loaded and composed in order (later wins on conflicts).
sections (
    transport.styx
    navigation.styx
    modes.styx
    editing.styx
    grid.styx
    options.styx
    tracks.styx
    lanes-takes.styx
    visibility.styx
    automation.styx
    fx.styx
    scrolling.styx
    zoom.styx
    markers.styx
    views.styx
    utility.styx
    midi-modes.styx
    midi.styx
    expression-editor.styx
    mouse.styx
)
