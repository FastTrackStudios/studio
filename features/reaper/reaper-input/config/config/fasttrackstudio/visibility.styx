which_key (
    {
        prefix v,
        label "Visibility Manager",
        entries (
            {key d, label "Drums", action "FTS_VISIBILITY_MANAGER_TOGGLE_DRUMS"}
            {key p, label "Percussion", action "FTS_VISIBILITY_MANAGER_TOGGLE_PERCUSSION"}
            {key b, label "Bass", action "FTS_VISIBILITY_MANAGER_TOGGLE_BASS"}
            {key g, label "Guitars", action "FTS_VISIBILITY_MANAGER_TOGGLE_GUITARS"}
            {key k, label "Keys", action "FTS_VISIBILITY_MANAGER_TOGGLE_KEYS"}
            {key s, label "Synths", action "FTS_VISIBILITY_MANAGER_TOGGLE_SYNTHS"}
            {key h, label "Horns", action "FTS_VISIBILITY_MANAGER_TOGGLE_HORNS"}
            {key v, label "Overview", action "FTS_SCENE_OVERVIEW"}
            {key t, label "Overview Top", action "FTS_SCENE_OVERVIEW_TOP"}
            {key l, label "Vocals", action "FTS_VISIBILITY_MANAGER_TOGGLE_VOCALS"}
            {key c, label "Choir", action "FTS_VISIBILITY_MANAGER_TOGGLE_CHOIR"}
            {key o, label "Orchestra", action "FTS_VISIBILITY_MANAGER_TOGGLE_ORCHESTRA"}
            {key x, label "SFX", action "FTS_VISIBILITY_MANAGER_TOGGLE_SFX"}
            {key r, label "Reference", action "FTS_VISIBILITY_MANAGER_TOGGLE_REFERENCE"}
            {key 0, label "Show All", action "FTS_VISIBILITY_MANAGER_SHOW_ALL"}
            {key 9, label "Hide All", action "FTS_VISIBILITY_MANAGER_HIDE_ALL"}
        )
    }
)
