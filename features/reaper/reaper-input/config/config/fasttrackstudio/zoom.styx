wheel (
    // Option+wheel zooms vertically.
    {modifiers "<A->",   action 1001,  desc "Zoom vertically reversed (Option+wheel)"}
    {modifiers "<A->",   action 1001,  horizontal true, desc "Zoom vertically reversed (Option+horizwheel)"}

    // Shift+Option+wheel zooms horizontally.
    {modifiers "<S-A->", action 979,   desc "Zoom horizontally reversed (Shift+Option+wheel)"}
    {modifiers "<S-A->", action 979,   horizontal true, desc "Zoom horizontally reversed (Shift+Option+horizwheel)"}

    // Ctrl+Option+wheel zooms vertically and horizontally together.
    {modifiers "<C-A->", action "1001+979", desc "Zoom vertically and horizontally reversed (Ctrl+Option+wheel)"}
    {modifiers "<C-A->", action "1001+979", horizontal true, desc "Zoom vertically and horizontally reversed (Ctrl+Option+horizwheel)"}
    {modifiers "<M-A->", action "1001+979", desc "Zoom vertically and horizontally reversed (Meta+Option+wheel)"}
    {modifiers "<M-A->", action "1001+979", horizontal true, desc "Zoom vertically and horizontally reversed (Meta+Option+horizwheel)"}

    // === MIDI Editor ===
    // Same modifier scheme as arrange, routed to the MIDI Editor section.
    // 40663 = Zoom vertically reversed, 40662 = Zoom horizontally reversed
    // (both "MIDI relative/mousewheel" actions, so they consume wheel delta).

    // Option+wheel zooms vertically (note height / piano roll keys).
    {modifiers "<A->",   action 40663, context @Midi, desc "MIDI: Zoom vertically reversed (Option+wheel)"}
    {modifiers "<A->",   action 40663, context @Midi, horizontal true, desc "MIDI: Zoom vertically reversed (Option+horizwheel)"}

    // Shift+Option+wheel zooms horizontally (time).
    {modifiers "<S-A->", action 40662, context @Midi, desc "MIDI: Zoom horizontally reversed (Shift+Option+wheel)"}
    {modifiers "<S-A->", action 40662, context @Midi, horizontal true, desc "MIDI: Zoom horizontally reversed (Shift+Option+horizwheel)"}

    // Ctrl/Meta+Option+wheel zooms vertically and horizontally together.
    {modifiers "<C-A->", action "40663+40662", context @Midi, desc "MIDI: Zoom vertically and horizontally reversed (Ctrl+Option+wheel)"}
    {modifiers "<C-A->", action "40663+40662", context @Midi, horizontal true, desc "MIDI: Zoom vertically and horizontally reversed (Ctrl+Option+horizwheel)"}
    {modifiers "<M-A->", action "40663+40662", context @Midi, desc "MIDI: Zoom vertically and horizontally reversed (Meta+Option+wheel)"}
    {modifiers "<M-A->", action "40663+40662", context @Midi, horizontal true, desc "MIDI: Zoom vertically and horizontally reversed (Meta+Option+horizwheel)"}
)
