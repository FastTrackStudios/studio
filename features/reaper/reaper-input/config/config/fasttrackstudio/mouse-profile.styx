    {ctx MM_CTX_MIDI_NOTEEDGE, mods "<S-C-A->", behavior "1 m", desc "Move note edge"}

    // MM_CTX_MIDI_PIANOROLL
    {ctx MM_CTX_MIDI_PIANOROLL, mods "", behavior "7 m", desc "Marquee select notes"}
    {ctx MM_CTX_MIDI_PIANOROLL, mods "<S->", behavior "9 m", desc "Marquee add to note selection"}
    {ctx MM_CTX_MIDI_PIANOROLL, mods "<C->", behavior "12 m", desc "Insert note, drag to move"}
    {ctx MM_CTX_MIDI_PIANOROLL, mods "<S-C->", behavior "1 m", desc "Insert note, drag to extend or change pitch"}

    // MM_CTX_MIDI_PIANOROLL_CLK
    {ctx MM_CTX_MIDI_PIANOROLL_CLK, mods "<S->", behavior "1 m", desc "Deselect all notes and move edit cursor"}
    {ctx MM_CTX_MIDI_PIANOROLL_CLK, mods "<C->", behavior "4 m", desc "Insert note"}
    {ctx MM_CTX_MIDI_PIANOROLL_CLK, mods "<S-C->", behavior "1 m", desc "Deselect all notes and move edit cursor"}
    {ctx MM_CTX_MIDI_PIANOROLL_CLK, mods "<C-A->", behavior "1 m", desc "Deselect all notes and move edit cursor"}

    // MM_CTX_MIDI_PIANOROLL_DBLCLK
    {ctx MM_CTX_MIDI_PIANOROLL_DBLCLK, mods "<C->", behavior "1 m", desc "Insert note"}
    {ctx MM_CTX_MIDI_PIANOROLL_DBLCLK, mods "<S-C->", behavior "1 m", desc "Insert note"}
    {ctx MM_CTX_MIDI_PIANOROLL_DBLCLK, mods "<A->", behavior "1 m", desc "Insert note"}
    {ctx MM_CTX_MIDI_PIANOROLL_DBLCLK, mods "<S-A->", behavior "1 m", desc "Insert note"}
    {ctx MM_CTX_MIDI_PIANOROLL_DBLCLK, mods "<C-A->", behavior "1 m", desc "Insert note"}
    {ctx MM_CTX_MIDI_PIANOROLL_DBLCLK, mods "<S-C-A->", behavior "1 m", desc "Insert note"}

    // MM_CTX_MIDI_RMOUSE
    {ctx MM_CTX_MIDI_RMOUSE, mods "<S-C->", behavior "1 m", desc "Marquee select notes/CC"}

    // MM_CTX_MIDI_RULER_CLK
    {ctx MM_CTX_MIDI_RULER_CLK, mods "<S-C->", behavior "1 m", desc "Move edit cursor"}
    {ctx MM_CTX_MIDI_RULER_CLK, mods "<S-A->", behavior "1 m", desc "Move edit cursor"}
    {ctx MM_CTX_MIDI_RULER_CLK, mods "<C-A->", behavior "1 m", desc "Move edit cursor"}
    {ctx MM_CTX_MIDI_RULER_CLK, mods "<S-C-A->", behavior "1 m", desc "Move edit cursor"}

    // MM_CTX_MIDI_RULER_DBLCLK
    {ctx MM_CTX_MIDI_RULER_DBLCLK, mods "<S->", behavior "1 m", desc "Zoom to selected notes/CC"}
    {ctx MM_CTX_MIDI_RULER_DBLCLK, mods "<C->", behavior "1 m", desc "Zoom to selected notes/CC"}
    {ctx MM_CTX_MIDI_RULER_DBLCLK, mods "<S-C->", behavior "1 m", desc "Zoom to selected notes/CC"}
    {ctx MM_CTX_MIDI_RULER_DBLCLK, mods "<A->", behavior "1 m", desc "Zoom to selected notes/CC"}
    {ctx MM_CTX_MIDI_RULER_DBLCLK, mods "<S-A->", behavior "1 m", desc "Zoom to selected notes/CC"}
    {ctx MM_CTX_MIDI_RULER_DBLCLK, mods "<C-A->", behavior "1 m", desc "Zoom to selected notes/CC"}
    {ctx MM_CTX_MIDI_RULER_DBLCLK, mods "<S-C-A->", behavior "1 m", desc "Zoom to selected notes/CC"}

    // MM_CTX_POOLEDENV
    {ctx MM_CTX_POOLEDENV, mods "<S-A->", behavior "1 m", desc "Move automation item - just snap"}

    // MM_CTX_POOLEDENV_DBLCLK
    {ctx MM_CTX_POOLEDENV_DBLCLK, mods "<A->", behavior "1 m", desc "Show automation item properties"}
    {ctx MM_CTX_POOLEDENV_DBLCLK, mods "<S-A->", behavior "1 m", desc "Show automation item properties"}
    {ctx MM_CTX_POOLEDENV_DBLCLK, mods "<C-A->", behavior "1 m", desc "Show automation item properties"}
    {ctx MM_CTX_POOLEDENV_DBLCLK, mods "<S-C-A->", behavior "1 m", desc "Show automation item properties"}

    // MM_CTX_POOLEDENVEDGE
    {ctx MM_CTX_POOLEDENVEDGE, mods "<C-A->", behavior "1 m", desc "Move automation item edge - just move"}
    {ctx MM_CTX_POOLEDENVEDGE, mods "<S-C-A->", behavior "1 m", desc "Move automation item edge - just move"}

    // MM_CTX_RULER
    {ctx MM_CTX_RULER, mods "<C->", behavior "0 m", desc "No action"}
    {ctx MM_CTX_RULER, mods "<S-C->", behavior "0 m", desc "No action"}
    {ctx MM_CTX_RULER, mods "<A->", behavior "0 m", desc "No action"}
    {ctx MM_CTX_RULER, mods "<S-A->", behavior "4 m", desc "Move loop points ignoring snap"}
    {ctx MM_CTX_RULER, mods "<C-A->", behavior "0 m", desc "No action"}
    {ctx MM_CTX_RULER, mods "<S-C-A->", behavior "0 m", desc "No action"}

    // MM_CTX_RULER_CLK
    {ctx MM_CTX_RULER_CLK, mods "<S-A->", behavior "1 m", desc "Move edit cursor"}
    {ctx MM_CTX_RULER_CLK, mods "<S-C-A->", behavior "1 m", desc "Move edit cursor"}

    // MM_CTX_RULER_DBLCLK
    {ctx MM_CTX_RULER_DBLCLK, mods "<S->", behavior "1 m", desc "Set loop points to region"}
    {ctx MM_CTX_RULER_DBLCLK, mods "<S-C->", behavior "1 m", desc "Set loop points to region"}
    {ctx MM_CTX_RULER_DBLCLK, mods "<S-A->", behavior "1 m", desc "Set loop points to region"}
    {ctx MM_CTX_RULER_DBLCLK, mods "<C-A->", behavior "1 m", desc "Set loop points to region"}
    {ctx MM_CTX_RULER_DBLCLK, mods "<S-C-A->", behavior "1 m", desc "Set loop points to region"}

    // MM_CTX_TCP_DBLCLK
    {ctx MM_CTX_TCP_DBLCLK, mods "<S-C->", behavior "1 m", desc "Select all media items on track"}
    {ctx MM_CTX_TCP_DBLCLK, mods "<A->", behavior "1 m", desc "Select all media items on track"}
    {ctx MM_CTX_TCP_DBLCLK, mods "<S-A->", behavior "1 m", desc "Select all media items on track"}
    {ctx MM_CTX_TCP_DBLCLK, mods "<C-A->", behavior "1 m", desc "Select all media items on track"}
    {ctx MM_CTX_TCP_DBLCLK, mods "<S-C-A->", behavior "1 m", desc "Select all media items on track"}

    // MM_CTX_TEMPOMARKER
    {ctx MM_CTX_TEMPOMARKER, mods "<S-C->", behavior "1 m", desc "Move project tempo/time signature marker"}
    {ctx MM_CTX_TEMPOMARKER, mods "<A->", behavior "1 m", desc "Move project tempo/time signature marker"}
    {ctx MM_CTX_TEMPOMARKER, mods "<S-A->", behavior "1 m", desc "Move project tempo/time signature marker"}
    {ctx MM_CTX_TEMPOMARKER, mods "<S-C-A->", behavior "1 m", desc "Move project tempo/time signature marker"}

    // MM_CTX_TRACK
    {ctx MM_CTX_TRACK, mods "", behavior "9 m", desc "Marquee select items"}
    {ctx MM_CTX_TRACK, mods "<S->", behavior "13 m", desc "Marquee add to item selection"}
    {ctx MM_CTX_TRACK, mods "<C->", behavior "25 m", desc "Draw empty MIDI item on same track"}
    {ctx MM_CTX_TRACK, mods "<S-C->", behavior "27 m", desc "Draw empty MIDI item on same track ignoring snap"}
    {ctx MM_CTX_TRACK, mods "<A->", behavior "22 m", desc "Marquee zoom"}
    {ctx MM_CTX_TRACK, mods "<S-A->", behavior "9 m", desc "Marquee select items"}

    // MM_CTX_TRACK_CLK
    {ctx MM_CTX_TRACK_CLK, mods "", behavior "3 m", desc "Deselect all items"}
    {ctx MM_CTX_TRACK_CLK, mods "<S->", behavior "1 m", desc "Deselect all items and move edit cursor"}
    {ctx MM_CTX_TRACK_CLK, mods "<S-A->", behavior "2 m", desc "Deselect all items and move edit cursor ignoring snap"}
    {ctx MM_CTX_TRACK_CLK, mods "<S-C-A->", behavior "3 m", desc "Deselect all items"}
)
