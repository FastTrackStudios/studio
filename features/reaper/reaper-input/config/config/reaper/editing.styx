bindings (
    // Clipboard
    {keys "<C-x>",        action 40059, desc "Cut items / tracks / envelope points"}
    {keys "<C-c>",        action 40060, desc "Copy items / tracks / envelope points"}
    {keys "<C-v>",        action 40058, desc "Paste items / tracks"}
    {keys "<C-S-v>",      action 42398, desc "Paste items / tracks preserving position"}

    // Undo / redo
    {keys "<C-z>",        action 40029, desc "Undo"}
    {keys "<C-S-z>",      action 40030, desc "Redo"}
    {keys "<C-M-z>",      action 40030, desc "Redo (alt)"}

    // Selection
    {keys "<C-a>",        action 40182, desc "Select all items"}
    {keys "<escape>",     action 40289, desc "Unselect all items"}

    // Split
    {keys s,            action 40757, desc "Split items at edit cursor"}
    {keys "<S-s>",        action 40061, desc "Split items at time selection"}

    // Delete
    {keys "<delete>",     action 40006, desc "Remove selected items"}
    {keys "<backspace>",  action 40006, desc "Remove selected items"}

    // Duplicate
    {keys "<C-d>",        action 41295, desc "Duplicate items"}

    // Glue
    {keys "<C-u>",        action 40362, desc "Glue items"}

    // Grouping
    {keys "<C-g>",        action 40032, desc "Group items"}
    {keys "<C-S-g>",      action 40033, desc "Remove items from group"}
    {keys g,            action 40034, desc "Select all items in group"}

    // MIDI editor
    {keys e,            action 40153, desc "Open items in MIDI editor"}

    // Track controls
    {keys "<F5>",         action 40281, desc "Toggle track mute"}
    {keys "<F6>",         action 40280, desc "Toggle track solo"}
    {keys "<F7>",         action 40490, desc "Toggle track record arm"}
    {keys "<F8>",         action 40495, desc "Cycle track record monitoring"}
    {keys "<F9>",         action 40410, desc "Toggle track phase"}

    // Item properties
    {keys "<F2>",         action 40340, desc "Item properties"}
    {keys "<C-f2>",       action 40652, desc "Rename item"}

    // Quantize
    {keys "<C-S-q>",      action 40070, desc "Quantize item positions to grid"}

    // Nudge
    {keys "<C-M-left>",   action 40794, desc "Nudge items left by grid"}
    {keys "<C-M-right>",  action 40793, desc "Nudge items right by grid"}

    // Track management
    {keys "<C-t>",        action 40001, desc "Insert new track"}

    // Trim
    {keys "<C-S-left>",   action 40225, desc "Trim left edge of item to edit cursor"}
    {keys "<C-S-right>",  action 40226, desc "Trim right edge of item to edit cursor"}

    // Fade
    {keys d,            action 40509, desc "Apply default fade-in to items"}
    {keys "<S-d>",        action 40510, desc "Apply default fade-out to items"}
    {keys "<C-S-d>",      action 40511, desc "Apply default crossfade to items"}

    // Reverse
    {keys "<C-r>",        action 41051, desc "Reverse items as new take"}
)
