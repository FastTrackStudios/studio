// daw-csi zone definitions — Behringer X-Touch (Mackie Control mode).
//
// CSI's .zon concept, in Styx. A zone binds widgets to actions;
// @GoZone{zone …} moves between zones; `include` inherits another
// zone's bindings (local entries override). Modifier-qualified keys
// (`shift+select`) bind the modified gesture; unmodified bindings are
// the fallback. This file is embedded as the built-in default —
// point FTS_CSI_ZONES at a copy to customize without rebuilding.
//
// Strip widgets:  fader vpot vpot_press rec solo mute select
//                 lcd_top lcd_bottom
// Buttons block:  master_fader jog play stop record rewind
//                 fast_forward cycle bank_left bank_right
//                 channel_left channel_right flip global_view marker
//                 nudge drop replace click solo_global up down left
//                 right zoom scrub f1–f8

@ ./zones.schema.styx

// Boot into folder mode — the band-family view is the home base;
// GLOBAL VIEW hops to the flat track list ("home" zone) and back.
home folder

zones {
    /// Track mode: the flat track list banked across the strips.
    home {
        navigator @Track
        strip {
            fader      @TrackVolume
            vpot       @TrackPan
            vpot_press @TrackPanReset
            rec        @TrackRecordArm
            control+rec @TrackTogglePolarity
            option+rec @CycleInputMonitor
            solo       @TrackSolo
            shift+solo @ClearAllSolo
            mute       @TrackMute
            shift+mute @UnmuteAll
            select     @TrackSelect
            shift+select @TrackRangeSelect
            control+select @TrackSelectAdditive
            lcd_top    @TrackName
            lcd_bottom @PanDisplay
        }
        buttons {
            master_fader  @MasterVolume
            jog           @JogPosition{seconds_per_tick 1}
            play          @Play
            stop          @Stop
            record        @Record
            cycle         @ToggleLoop
            rewind        @NudgePosition{seconds -5}
            fast_forward  @NudgePosition{seconds 5}
            bank_left     @Bank{amount -8}
            bank_right    @Bank{amount 8}
            channel_left  @Bank{amount -1}
            channel_right @Bank{amount 1}
            global_view   @GoZone{zone folder}
            shift+global_view @ToggleScrollLink
            assign_plugin @GoZone{zone fxmenu}
            assign_send   @GoZone{zone sends}
            assign_eq     @GoZone{zone receives}
            flip          @Flip
            smpte_beats   @CycleTimeDisplay
            save          @SaveProject
            undo          @Undo
            shift+undo    @Redo
            marker        @AddMarker
            left          @PrevMarker
            right         @NextMarker
            solo_global   @ClearAllSolo
            click         @ToggleMetronome
            auto_trim     @TrackAutoMode{mode @Trim}
            auto_read     @TrackAutoMode{mode @Read}
            auto_touch    @TrackAutoMode{mode @Touch}
            auto_write    @TrackAutoMode{mode @Write}
            auto_latch    @TrackAutoMode{mode @Latch}
        }
    }

    /// Folder mode: top-level folders on the strips; SELECT spills a
    /// folder (the folder leads its children), SELECT on the spilled
    /// parent pops back up — CSI's ToggleFolderSpill. Folder names
    /// carry a glyph (`>Name` drillable, `<Name` spilled parent), so
    /// the bottom row keeps pan — and live volume while the fader is
    /// touched.
    folder {
        include (home)
        navigator @Folder
        strip {
            select     @FolderSpill
            hold+select @TrackSelect
            flip+fader @TrackPan
            lcd_bottom @PanDisplay
        }
        buttons {
            global_view @GoZone{zone home}
        }
    }

    /// FX menu: strips show the SELECTED track's FX chain. SELECT
    /// focuses an FX and opens its parameter zone; MUTE bypasses
    /// (LED lit = active).
    fxmenu {
        display_color @Blue
        strip {
            lcd_top @FxMenuNameDisplay
            lcd_bottom @Blank
            select  @FxMenuSelect{zone fx}
            mute    @FxMenuBypass
            rec     @NoAction
            solo    @NoAction
        }
        buttons {
            master_fader  @MasterVolume
            play @Play
            stop @Stop
            record @Record
            cycle @ToggleLoop
            assign_plugin @GoZone{zone home}
            global_view   @GoZone{zone home}
        }
    }

    /// Sends: strips are the SELECTED track's send slots (cyan, like
    /// CSI's SelectedTrackSend). Fader rides the send level, v-pot
    /// pans it, MUTE toggles; CHANNEL </> pages slots.
    sends {
        display_color @Cyan
        strip {
            fader      @SendVolume
            vpot       @SendPan
            mute       @SendMute
            lcd_top    @SendNameDisplay
            lcd_bottom @SendVolumeDisplay
            rec        @NoAction
            solo       @NoAction
            select     @NoAction
        }
        buttons {
            master_fader  @MasterVolume
            play @Play
            stop @Stop
            record @Record
            cycle @ToggleLoop
            channel_left  @BankSends{amount -1}
            channel_right @BankSends{amount 1}
            assign_send   @GoZone{zone home}
            global_view   @GoZone{zone home}
        }
    }

    /// Receives: mirror of sends for the selected track's inputs.
    receives {
        display_color @Magenta
        strip {
            fader      @ReceiveVolume
            vpot       @ReceivePan
            mute       @ReceiveMute
            lcd_top    @ReceiveNameDisplay
            lcd_bottom @ReceiveVolumeDisplay
            rec        @NoAction
            solo       @NoAction
            select     @NoAction
        }
        buttons {
            master_fader  @MasterVolume
            play @Play
            stop @Stop
            record @Record
            cycle @ToggleLoop
            channel_left  @BankReceives{amount -1}
            channel_right @BankReceives{amount 1}
            assign_eq     @GoZone{zone home}
            global_view   @GoZone{zone home}
        }
    }

    /// FX params: strips are the focused FX's parameters — v-pot
    /// turns, fader rides, both rows show name/value. CHANNEL </>
    /// pages through plugins with more than 8 parameters.
    fx {
        display_color @Green
        strip {
            fader      @FxParam
            vpot       @FxParam
            lcd_top    @FxParamNameDisplay
            lcd_bottom @FxParamValueDisplay
            mute       @NoAction
            rec        @NoAction
            solo       @NoAction
            select     @NoAction
        }
        buttons {
            master_fader  @MasterVolume
            play @Play
            stop @Stop
            record @Record
            cycle @ToggleLoop
            channel_left  @BankFxParams{amount -1}
            channel_right @BankFxParams{amount 1}
            bank_left     @BankFxParams{amount -8}
            bank_right    @BankFxParams{amount 8}
            f1            @FxPrevPreset
            f2            @FxNextPreset
            assign_plugin @GoZone{zone fxmenu}
            global_view   @GoZone{zone home}
        }
    }
}
