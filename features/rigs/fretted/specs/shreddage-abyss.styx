// Shreddage 3.5 Abyss (Impact Soundworks) — library spec.
//
// A six-string bass (drop A: A E A D G C), one DI channel ("Blend").
// The Shreddage 3.5 engine (script_0.ksp) places every note on a string
// and fret and plays that string's group; the engine's fretboard stage does
// the same from `fretboard` in the instrument's section.styx (strings,
// hand, placement weights, RR orders, anti-repetition), which
// features/rigs/fretted/tests/shreddage_section.py writes from the decode.
// Zones: tests/shreddage_zones.py. The decode notes are on AudioHaven:
// Sampled/Guitar/Shreddage Abyss/_notes/engine-model.md.
//
// Modelled so far, at the shipped settings (hand fixed at fret 0, Natural
// fretting, anti-repetition 25 %, one multitrack guitar, Console empty):
// single notes of Sustain, Staccato and Harmonics. Not yet: Pop (layered on
// Sustain at velocity 110-127), hammer-on / pull-off (velocity 1-60 on a
// ringing string), slides (key 17 held), Tapping, the pitched release, FX,
// chords (the poly-window voicing search).

name    "Shreddage 3.5 Abyss"
vendor  "Impact Soundworks"
version "3.5"

sections (
    { id abyss, label "Abyss", lowest_note A0, highest_note C4 }
)

mics (
    { id Blend, label "DI", kind blended, default true }
)

performance {
    resample_transpose true   // a key between two sampled frets is resampled, as Kontakt does
    strict_key_ranges  true
    max_repeat_strikes 0
    zone_pitch_tolerance 0
    release_delay_ms   0.0
}

dynamics {
    short_note_controller  velocity
    enable_velocity_layers true
}

// Layer edges, levels and envelopes are the instrument's (section.styx).
articulations (
    { id Sustain,   label "Sustain",   kind @Sustain, dynamics (v1 v2 v3 v4), rr 4, dyn_ctrl velocity, notes full }
    { id Staccato,  label "Staccato",  kind @Sustain, dynamics (v1 v2 v3),    rr 8, dyn_ctrl velocity, notes full }
    { id Harmonics, label "Harmonics", kind @Sustain, dynamics (v1 v2),       rr 4, dyn_ctrl velocity, notes full }
)

// TACT keyswitches as shipped (latched; `%tact___matrix[128·a + 11]`).
// C0 = MIDI 12.
keyswitch {
    velocity_sensitive false
    user_configurable  true
    notes (
        { note "C0",  label "Sustain",   vel_map { 0-127 "Sustain" } }
        { note "C#0", label "Staccato",  vel_map { 0-127 "Staccato" } }
        { note "D#0", label "Harmonics", vel_map { 0-127 "Harmonics" } }
    )
}
