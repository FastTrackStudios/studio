// Schema for daw-csi zone files (xtouch.zones.styx and user
// overrides via FTS_CSI_ZONES). Validate with:
//   styx my.zones.styx --validate --schema zones.schema.styx

meta {
    id https://fasttrackstudios.com/schemas/daw-csi-zones
    version 2026-06-05
    description "daw-csi control-surface zone definitions"
}

schema {
    @ @object{
        /// Zone activated at startup (defaults to "home").
        home @optional(@string)
        /// Zone name → definition. Names are free-form; @GoZone and
        /// `include` reference them.
        zones @map(@Zone)
    }

    Zone @object{
        /// Inherit bindings from these zones in order (later wins);
        /// local entries override. CSI's IncludedZones.
        include @optional(@seq(@string))
        /// Navigator pinned while this zone is active.
        navigator @optional(@enum{Track, Folder, Vca})
        /// Override every scribble backlight while active (CSI's
        /// SetXTouchDisplayColors); track colors restore on exit.
        display_color @optional(@enum{Off, Red, Green, Yellow, Blue, Magenta, Cyan, White})
        /// Per-strip widget → action. Keys may carry modifier
        /// prefixes: shift+ option+ control+ alt+ hold+
        /// (e.g. shift+select, hold+select).
        strip @optional(@map(@Action))
        /// Master-section widget → action (same modifier prefixes).
        buttons @optional(@map(@Action))
    }

    Action @enum{
        // Strip control
        TrackVolume
        TrackPan
        TrackPanReset
        TrackMute
        TrackSolo
        TrackRecordArm
        TrackSelect
        TrackSelectAdditive
        TrackRangeSelect
        TrackTogglePolarity
        FolderSpill
        VcaSpill
        // Strip: send slots of the selected track
        SendVolume
        SendPan
        SendMute
        ReceiveVolume
        ReceivePan
        ReceiveMute
        // Strip: FX (menu = chain of the selected track; params = focused FX)
        FxMenuSelect @object{zone @string}
        FxMenuBypass
        FxParam
        FxNextPreset
        FxPrevPreset
        LastTouchedFxParam
        // Strip displays
        TrackName
        PanDisplay
        VolumeDisplay
        FolderIndicator
        SendNameDisplay
        SendVolumeDisplay
        SendPanDisplay
        ReceiveNameDisplay
        ReceiveVolumeDisplay
        ReceivePanDisplay
        FxMenuNameDisplay
        FxParamNameDisplay
        FxParamValueDisplay
        Fixed @object{text @string}
        Blank
        // Master / global
        MasterVolume
        Play
        Stop
        Record
        ToggleLoop
        ClearAllSolo
        UnmuteAll
        NudgePosition @object{seconds @float}
        JogPosition @object{seconds_per_tick @float}
        Bank @object{amount @int}
        BankSends @object{amount @int}
        BankReceives @object{amount @int}
        BankFxParams @object{amount @int}
        GoZone @object{zone @string}
        SaveProject
        Undo
        Redo
        Command @object{id @string}
        AddMarker
        PrevMarker
        NextMarker
        Flip
        Toggle
        ToggleScrollLink
        TrackAutoMode @object{mode @enum{Trim, Read, Touch, Write, Latch}}
        CycleInputMonitor
        ToggleMetronome
        CycleTimeDisplay
        NoAction
    }
}
