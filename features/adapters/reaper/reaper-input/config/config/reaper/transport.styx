bindings (
    // Primary transport
    {keys "<space>",    action 40044, desc "Play / Stop"}
    {keys "<C-space>",  action 40073, desc "Play / Pause"}
    {keys r,            action 1013,  desc "Record"}
    {keys "<S-r>",        action 40046, desc "Toggle record"}

    // Navigation
    {keys w,            action 40042, desc "Go to start of project"}
    {keys "<C-home>",     action 40042, desc "Go to start of project"}
    {keys "<C-end>",      action 40043, desc "Go to end of project"}

    // Rewind / forward
    {keys "<C-->",        action 40084, desc "Rewind"}
    {keys "<C-=>",        action 40085, desc "Fast forward"}

    // Loop
    {keys l,            action 1068,  desc "Toggle repeat"}

    // Metronome
    {keys "<M-m>",        action 40364, desc "Toggle metronome"}

    // Tempo
    {keys h,            action 1134,  desc "Tap tempo"}

    // Markers
    {keys ";",          action 40172, desc "Go to previous marker / project start"}
    {keys "'",          action 40173, desc "Go to next marker / project end"}
    {keys m,            action 40157, desc "Insert marker at current position"}
    {keys "<S-m>",        action 40171, desc "Insert and name marker"}

    // Regions
    {keys "<S-r>",        action 40174, desc "Insert region from time selection"}
)
