// Fast Slip Edit workflow.
// Identity derived from filename: id = "fast-slip-edit", name = "Fast Slip Edit".

keybind_overlays (fast-slip-edit)
mouse_overlays   (fast-slip-edit)

settings (
    {command 1157,  enabled false, desc "Disable snapping"}
    {command 40912, enabled true,  desc "Enable auto-crossfade on split"}
)
