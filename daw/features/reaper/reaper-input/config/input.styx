// FTS Input — runtime configuration
//
// Edit and save this file while REAPER is running to hot-reload settings.
// Changes take effect within ~1 second.

/// Which keyboard/mouse profile to use.
/// Options: @FastTrackStudio | @Logic | @ProTools
profile @FastTrackStudio

/// Start with the FTS Input handler active.
/// Set to true to enable input interception as soon as REAPER loads.
enabled true

/// Consume key events that a binding handles.
/// When true, matched keys are swallowed so REAPER never sees them.
/// Set to false for passthrough/debug mode.
eat_handled_keys true

/// Verbose event logging to /tmp/reaper-fts-input.log
debug_logging true
