bindings (
    // Navigation — hjkl navigate like the arrange view. `passthrough true`
    // forces these to run in the MAIN section from inside the editor, so they
    // drive the shared edit cursor / track selection exactly as in arrange.
    // (Note move + transpose moved off hjkl onto the arrow keys below.)
    {keys h,        action 40838, context @Midi, passthrough true, desc "Move edit cursor to current/previous measure"}
    {keys l,        action 40837, context @Midi, passthrough true, desc "Move edit cursor to next measure"}
    {keys j,        action 40285, context @Midi, passthrough true, desc "Select next track"}
    {keys k,        action 40286, context @Midi, passthrough true, desc "Select previous track"}

    // Note move / transpose — arrows run in the MIDI Editor section (@Midi,
    // no passthrough). IDs verified against REAPER's action dump (ActionList).
    {keys "<left>",   action 40183, context @Midi, desc "Move notes left one grid unit"}
    {keys "<right>",  action 40184, context @Midi, desc "Move notes right one grid unit"}
    {keys "<up>",     action 40177, context @Midi, desc "Move notes up one semitone"}
    {keys "<down>",   action 40178, context @Midi, desc "Move notes down one semitone"}
    {keys "<S-up>",   action 40179, context @Midi, desc "Move notes up one octave"}
    {keys "<S-down>", action 40180, context @Midi, desc "Move notes down one octave"}

    // Editing
    {keys d,            action 40002, context @Midi, desc "Delete notes"}
    {keys "<delete>",     action 40667, context @Midi, desc "Delete events"}
    {keys "<backspace>",  action 40667, context @Midi, desc "Delete events"}
    {keys x,        action 40012, context @Midi, desc "Cut"}
    {keys y,        action 40010, context @Midi, desc "Copy"}
    {keys p,        action 40011, context @Midi, desc "Paste"}
    {keys u,        action 40013, context @Midi, desc "Undo"}
    {keys "<C-r>",  action 40014, context @Midi, desc "Redo"}

    // Selection
    {keys v,         action 40003, context @Midi, desc "Select all notes"}
    {keys "<escape>",  action 40214, context @Midi, desc "Unselect all"}

    // Note length (by grid unit)
    {keys "<S-h>",  action 40447, context @Midi, desc "Shorten notes one grid unit"}
    {keys "<S-l>",  action 40446, context @Midi, desc "Lengthen notes one grid unit"}

    // Quantize & velocity
    {keys q,        action 40469, context @Midi, desc "Quantize notes position to grid"}
    {keys "+",      action 40462, context @Midi, desc "Note velocity +01"}
    {keys "-",      action 40464, context @Midi, desc "Note velocity -01"}

    // Tools
    {keys i,        action 40051, context @Midi, desc "Insert note at edit cursor"}
    {keys s,        action 40046, context @Midi, desc "Split notes"}

    // MIDI editor toggle — counterpart to `<S-e>` (open) in editing.styx.
    // MIDI-editor section action 2 = File: Close window.
    {keys e,        action 2, context @Midi, desc "Close MIDI editor"}
    {keys "<S-e>",  action 2, context @Midi, desc "Close MIDI editor"}

    // Zoom menu (z prefix) — built-ins plus the best of FTC MeMagic
    // (MIDI Editor Magic bundle, `_RS7d3c_*` = MIDI-editor-section scripts).
    //
    // Zoom-to targets:
    //   z z = the workhorse: whole item, all notes fitted (MeMagic 2-3)
    {keys "z z", action "_RS7d3c_88e4f763c4961fc6b461d08d9d29f4096d0c9859", context @Midi, desc "Zoom to Item (fit all notes)"}
    {keys "z c", action 40466, context @Midi, desc "Zoom to Content"}
    {keys "z s", action 40725, context @Midi, desc "Zoom to Selected Notes/CC"}
    {keys "z l", action 40468, context @Midi, desc "Zoom to One Loop Iteration"}
    {keys "z p", action 40726, context @Midi, desc "Zoom to Project Loop Selection"}

    // Smart / contextual (MeMagic):
    //   z m = 4 measures at cursor, centered on notes (3-8)
    //   z n = smart zoom ~20 notes at cursor, fit notes (5-3)
    //   z v = fit notes currently visible, vertical only (1-2)
    //   z a = fit all notes in item, vertical only (1-3)
    {keys "z m", action "_RS7d3c_904645840b8822dc1529a932362158f8ed8cf40b", context @Midi, desc "4 Measures at Cursor"}
    {keys "z n", action "_RS7d3c_c4e4f769d7fd445a23fffce0bb4bcdc489c83cef", context @Midi, desc "Smart Zoom (~20 notes)"}
    {keys "z v", action "_RS7d3c_0c56f90e80cc0f7355c789c29b5e3313be871d19", context @Midi, desc "Fit Notes (visible area)"}
    {keys "z a", action "_RS7d3c_6fbb3691823ff515f3b3b25f8b6055e1fda51651", context @Midi, desc "Fit Notes (whole item)"}

    // Scroll-to targets (MeMagic):
    //   z h/b = highest / lowest (bottom) note in item, z e = edit cursor,
    //   z u = note row under mouse
    {keys "z h", action "_RS7d3c_3f72ed251f40d9b3b8d8b50ac713d945867c741b", context @Midi, desc "Scroll to Highest Note"}
    {keys "z b", action "_RS7d3c_af549493bba3f2ae38a93ecfcab15d1c4216a50e", context @Midi, desc "Scroll to Lowest Note"}
    {keys "z e", action "_RS7d3c_17fffd84f7a7a3ddd642e258dbc5be4c7d95146e", context @Midi, desc "Scroll to Edit Cursor"}
    {keys "z u", action "_RS7d3c_99b0d4e6ba60286704bc0a98bec7778cbdcf9ffd", context @Midi, desc "Scroll to Note Under Mouse"}

    // Directional zoom (vim): i/o horizontal in/out, k/j vertical in/out.
    {keys "z i", action 1012,  context @Midi, desc "Zoom In Horizontally"}
    {keys "z o", action 1011,  context @Midi, desc "Zoom Out Horizontally"}
    {keys "z k", action 40111, context @Midi, desc "Zoom In Vertically"}
    {keys "z j", action 40112, context @Midi, desc "Zoom Out Vertically"}

    // CC lane zoom
    {keys "z r", action 42434, context @Midi, desc "Reset CC Lane Zoom"}

    // Grid menu (g prefix) — mirrors the arrange grid tree (grid.styx) with
    // the MIDI-editor-section equivalents, so the same muscle memory sets the
    // editor grid. Division on the QWER row, toggles on home-row letters.
    {keys "g q", action 40204, context @Midi, desc "Grid 1 (Whole)"}
    {keys "g w", action 40203, context @Midi, desc "Grid 1/2 (Half)"}
    {keys "g e", action 40197, context @Midi, desc "Grid 1/8 (Eighth)"}
    {keys "g r", action 40192, context @Midi, desc "Grid 1/16"}
    {keys "g g", action 1017,  context @Midi, desc "Toggle Grid"}
    {keys "g s", action "_NF_ME_TOGGLESWING",   context @Midi, desc "Toggle Swing Grid"}
    {keys "g d", action "_NF_ME_TOGGLEDOTTED",  context @Midi, desc "Toggle Dotted Grid"}
    {keys "g t", action "_NF_ME_TOGGLETRIPLET", context @Midi, desc "Toggle Triplet Grid"}
    // NOTE: pencil/erase "modes" are mouse-modifier tools in REAPER, not
    // bindable actions — there is no action ID for them, so `r` (erase mode)
    // is intentionally left unbound. Use a mouse-modifier preset for tools.
)

wheel (
    {modifiers "",    action 40432, context @Midi, desc "Scroll view vertically"}
    {modifiers "<S->",  action 40433, context @Midi, desc "Scroll horizontally (Shift+wheel)"}
    // Zoom wheel bindings live in zoom.styx.
)
