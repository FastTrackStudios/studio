which_key (
    {
        prefix o,
        label "Options",
        entries (
            {key s, label "Toggle Snap", action 1157}
            {key m, label "Toggle Metronome", action 40364}
            {key p, label "Metronome/Pre-roll Settings", action 40363}
            {key x, label "Toggle Auto-crossfade", action 40041}
            {key e, label "Cycle Editing Mode", action 41116}
            {key r, label "Cycle Ripple Editing", action 1155}
            {key t, label "Ripple Per-track", action 41990}
            {key a, label "Ripple All Tracks", action 41991}
            {key g, label "Toggle Grid Lines", action 40145}
            {key l, label "Loop Points Follow Time Selection", action 40621}
            {key v, label "Auto-scroll Playback", action 40036}
            {key R, label "Auto-scroll Recording", action 40262}
            {key n, label "Pre-roll on Play", action 41818}
            {key b, label "Pre-roll on Record", action 41819}
            {key E, label "Move Envelope Points with Items", action 40070}
        )
    }
)
