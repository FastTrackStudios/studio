bindings (
    {keys "<S-r>", action 40211, desc "MIDI retroactive record for armed and selected tracks"}
)

which_key (
    {
        prefix m,
        label "Go to Marker/Section",
        entries (
            {key c, label "Chorus (CH)", action "_FTS_SESSION_GOTO_CHORUS_REGION"}
            {key v, label "Verse (VS)", action "_FTS_SESSION_GOTO_VERSE_REGION"}
            {key p, label "Pre-Chorus (PC)", action "_FTS_SESSION_GOTO_PRE_CHORUS_REGION"}
            {key b, label "Bridge (BR)", action "_FTS_SESSION_GOTO_BRIDGE_REGION"}
            {key i, label "Intro (IN)", action "_FTS_SESSION_GOTO_INTRO_REGION"}
            {key o, label "Outro (OUT)", action "_FTS_SESSION_GOTO_OUTRO_REGION"}
            {key n, label "Instrumental (INST)", action "_FTS_SESSION_GOTO_INSTRUMENTAL_REGION"}
            {key s, label "Solo (SOLO)", action "_FTS_SESSION_GOTO_SOLO_REGION"}
            {key h, label "Hits (HITS)", action "_FTS_SESSION_GOTO_HITS_REGION"}
            {key l, label "Interlude (INT)", action "_FTS_SESSION_GOTO_INTERLUDE_REGION"}
            {key d, label "Breakdown (BD)", action "_FTS_SESSION_GOTO_BREAKDOWN_REGION"}
            {key a, label "Vamp (VAMP)", action "_FTS_SESSION_GOTO_VAMP_REGION"}
            {key q, label "Count-In (COUNT-IN)", action "_FTS_SESSION_GOTO_COUNT_IN_REGION"}
            {key e, label "End (END)", action "_FTS_SESSION_GOTO_END_REGION"}
            {key m, label "Structural Markers", children (
                {key c, label "COUNT-IN", action "_FTS_SESSION_INSERT_COUNT_IN_MARKER"}
                {key s, label "=START",   action "_FTS_SESSION_INSERT_START_MARKER"}
                {key e, label "=END",     action "_FTS_SESSION_INSERT_END_MARKER"}
                {key g, label "Song", children (
                    {key s, label "SONGSTART", action "_FTS_SESSION_INSERT_SONGSTART_MARKER"}
                    {key e, label "SONGEND",   action "_FTS_SESSION_INSERT_SONGEND_MARKER"}
                )}
            )}
        )
    }
    {
        prefix "<S-m>",
        label "Insert Marker/Section",
        // Shift is part of the anchor, so let children match with or without
        // Shift held — the user can keep Shift down (for time-selection)
        // while tapping leaves like `c`, `v`, `p`.
        case_insensitive true,
        entries (
            {key c, label "Insert Region - Chorus (CH)", action "_FTS_SESSION_INSERT_CHORUS_REGION"}
            {key v, label "Insert Region - Verse (VS)", action "_FTS_SESSION_INSERT_VERSE_REGION"}
            {key p, label "Insert Region - Pre-Chorus (PRE-CH)", action "_FTS_SESSION_INSERT_PRE_CHORUS_REGION"}
            {key b, label "Insert Region - Bridge (BR)", action "_FTS_SESSION_INSERT_BRIDGE_REGION"}
            {key i, label "Insert Region - Intro (IN)", action "_FTS_SESSION_INSERT_INTRO_REGION"}
            {key o, label "Insert Region - Outro (OUT)", action "_FTS_SESSION_INSERT_OUTRO_REGION"}
            {key n, label "Insert Region - Instrumental (INST)", action "_FTS_SESSION_INSERT_INSTRUMENTAL_REGION"}
            {key s, label "Insert Region - Solo (SOLO)", action "_FTS_SESSION_INSERT_SOLO_REGION"}
            {key h, label "Insert Region - Hits (HITS)", action "_FTS_SESSION_INSERT_HITS_REGION"}
            {key l, label "Insert Region - Interlude (INT)", action "_FTS_SESSION_INSERT_INTERLUDE_REGION"}
            {key d, label "Insert Region - Breakdown (BD)", action "_FTS_SESSION_INSERT_BREAKDOWN_REGION"}
            {key a, label "Insert Region - Vamp (VAMP)", action "_FTS_SESSION_INSERT_VAMP_REGION"}
            {key q, label "Insert Region - Count-In (COUNT-IN)", action "_FTS_SESSION_INSERT_COUNT_IN_REGION"}
            {key e, label "Insert Region - End (END)", action "_FTS_SESSION_INSERT_END_REGION"}
            {key m, label "Structural Markers", children (
                {key c, label "COUNT-IN", action "_FTS_SESSION_INSERT_COUNT_IN_MARKER"}
                {key s, label "=START",   action "_FTS_SESSION_INSERT_START_MARKER"}
                {key e, label "=END",     action "_FTS_SESSION_INSERT_END_MARKER"}
                // SONGSTART/SONGEND on their own letters (not shifted s/e) so
                // `case_insensitive` doesn't collapse them onto the
                // =START/=END entries above.
                {key g, label "Song", children (
                    {key s, label "SONGSTART", action "_FTS_SESSION_INSERT_SONGSTART_MARKER"}
                    {key e, label "SONGEND",   action "_FTS_SESSION_INSERT_SONGEND_MARKER"}
                )}
            )}
        )
    }
)
