// Session mode switching.
//
// Two ways to switch modes:
//
//   1. Direct chord (fastest, two-hand): `<A-1>` … `<A-9>` jump straight
//      to a mode. Numbers ordered by production-flow phase.
//
//   2. Letter prefix (one-hand, mnemonic): `<A-m>` opens a tree where
//      each leaf is a letter you'd associate with the mode. With
//      `case_insensitive` you can keep Alt held the whole time —
//      `Alt+m`, `Alt+r` rapid-fires Record.
bindings (
    {keys "<A-0>", action "_FTS_SESSION_MODE_SCORING",  desc "Mode: Scoring"}
    {keys "<A-1>", action "_FTS_SESSION_MODE_ORGANIZE", desc "Mode: Organize"}
    {keys "<A-2>", action "_FTS_SESSION_MODE_WRITE",    desc "Mode: Write"}
    {keys "<A-3>", action "_FTS_SESSION_MODE_PRODUCE",  desc "Mode: Produce"}
    {keys "<A-4>", action "_FTS_SESSION_MODE_RECORD",   desc "Mode: Record"}
    {keys "<A-5>", action "_FTS_SESSION_MODE_EDIT",     desc "Mode: Edit"}
    {keys "<A-6>", action "_FTS_SESSION_MODE_MIX",      desc "Mode: Mix"}
    {keys "<A-7>", action "_FTS_SESSION_MODE_MASTER",   desc "Mode: Master"}
    {keys "<A-8>", action "_FTS_SESSION_MODE_LIVE",     desc "Mode: Live"}
    {keys "<A-9>", action "_FTS_SESSION_MODE_VIDEO",    desc "Mode: Video"}
)

which_key (
    {
        prefix "<A-m>",
        label "Session Mode",
        // Alt is part of the anchor — let children match with Alt held or
        // released, so the user can hold Alt+m and rapidly tap letters.
        case_insensitive true,
        entries (
            {key s, label "Scoring", action "_FTS_SESSION_MODE_SCORING"}  // s for Scoring
            {key o, label "Organize", action "_FTS_SESSION_MODE_ORGANIZE"}
            {key w, label "Write",    action "_FTS_SESSION_MODE_WRITE"}
            {key p, label "Produce",  action "_FTS_SESSION_MODE_PRODUCE"}
            {key r, label "Record",   action "_FTS_SESSION_MODE_RECORD"}
            {key e, label "Edit",     action "_FTS_SESSION_MODE_EDIT"}
            {key x, label "Mix",      action "_FTS_SESSION_MODE_MIX"}      // x because m is the anchor
            {key m, label "Master",   action "_FTS_SESSION_MODE_MASTER"}
            {key l, label "Live",     action "_FTS_SESSION_MODE_LIVE"}
            {key v, label "Video",    action "_FTS_SESSION_MODE_VIDEO"}
        )
    }
)
