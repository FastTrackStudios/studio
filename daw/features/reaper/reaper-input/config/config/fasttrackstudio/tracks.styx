bindings (
    {keys "<C-t>",   action 40001, desc "Insert new track"}
)

which_key (
    // `n` — Track manager.
    //
    // Drives the FTS Session track-manager add-* family. Letter keys are
    // mnemonic for the entity being added.
    {
        prefix n,
        label "Track Manager",
        entries (
            {key n, label "New Blank Track",  action 40001}  // Track: Insert new track
            {key d, label "Duplicate Tracks", action 40702}  // Track: Duplicate tracks

            // FTS Track Manager
            {key a, label "Add Arrangement", action "_FTS_SESSION_TRACK_MANAGER_ADD_ARRANGEMENT"}
            {key c, label "Add Channel",     action "_FTS_SESSION_TRACK_MANAGER_ADD_CHANNEL"}
            {key l, label "Add Layer",       action "_FTS_SESSION_TRACK_MANAGER_ADD_LAYER"}
            {key m, label "Add Multi-Mic",   action "_FTS_SESSION_TRACK_MANAGER_ADD_MULTI_MIC"}
            {key p, label "Add Performer",   action "_FTS_SESSION_TRACK_MANAGER_ADD_PERFORMER"}
        )
    }

    // `N` (Shift+n) — Create new categorized session track.
    //
    // Drives the FTS Session create-new-* family. Mnemonic layout:
    //   d = drum kit, e = electronic drum kit, c = percussion
    //   l = lead vocals, v = background vocals (BG/V)
    //   a = acoustic guitar, g = electric guitar, b = bass guitar
    //   p = piano, k = electric keys, o = organ
    //   s = synth submenu (arp/bass/lead/pad)
    //   m = mix bus hierarchy (MIX BUS / INSTRUMENTAL / vocal buses)
    {
        prefix "<S-n>",
        label "Create New Track",
        // Shift is part of the anchor — let children match with or without
        // Shift held, so the user can keep Shift down while tapping leaves
        // and rapidly create multiple tracks.
        case_insensitive true,
        entries (
            {key d, label "Drum Kit",          action "_FTS_SESSION_CREATE_NEW_DRUM_KIT"}
            {key e, label "Electronic Drums",  action "_FTS_SESSION_CREATE_NEW_ELECTRONIC_DRUMS"}
            {key c, label "Percussion",        action "_FTS_SESSION_CREATE_NEW_PERCUSSION"}
            {key l, label "Lead Vocals",       action "_FTS_SESSION_CREATE_NEW_LEAD_VOCALS"}
            {key v, label "Background Vocals", action "_FTS_SESSION_CREATE_NEW_BACKGROUND_VOCALS"}
            {key a, label "Acoustic Guitar",   action "_FTS_SESSION_CREATE_NEW_ACOUSTIC_GUITAR"}
            {key g, label "Electric Guitar",   action "_FTS_SESSION_CREATE_NEW_ELECTRIC_GUITAR"}
            {key b, label "Bass Guitar",       action "_FTS_SESSION_CREATE_NEW_BASS_GUITAR"}
            {key p, label "Piano",             action "_FTS_SESSION_CREATE_NEW_PIANO"}
            {key k, label "Electric Keys",     action "_FTS_SESSION_CREATE_NEW_ELECTRIC_KEYS"}
            {key o, label "Organ",             action "_FTS_SESSION_CREATE_NEW_ORGAN"}
            {key m, label "Mix Bus",           action "_FTS_SESSION_CREATE_NEW_MIX_BUS"}
            {key s, label "Synth", children (
                {key a, label "Arp",  action "_FTS_SESSION_CREATE_NEW_SYNTH_ARP"}
                {key b, label "Bass", action "_FTS_SESSION_CREATE_NEW_SYNTH_BASS"}
                {key l, label "Lead", action "_FTS_SESSION_CREATE_NEW_SYNTH_LEAD"}
                {key p, label "Pad",  action "_FTS_SESSION_CREATE_NEW_SYNTH_PAD"}
            )}
        )
    }
)
