bindings (
    {keys "<space>",   action 40044,  desc "Play / Stop",
     mnemonic "the universal transport key",
     why "Space is play in every DAW and every video player — zero relearning cost. Plain Space stops AND returns the edit cursor, which is the behavior you want while editing."}
    {keys "<S-space>",   action 40073,  desc "Play / Pause",
     mnemonic "Shift = softer stop",
     why "Shift-Space pauses in place instead of snapping back — the modifier softens the action: same key family, gentler behavior, like Shift-variants elsewhere in the profile."}
    {keys "<C-S-space>", action 40317,  desc "Play (skip time selection)",
     why "Escalating the modifier stack escalates how special the playback is — Ctrl+Shift+Space auditions an edit by skipping the selected region."}
    {keys "<enter>",   action 40042,  desc "Go to start of project",
     mnemonic "Enter = from the top",
     why "Mirrors the classic tape-machine RTZ (return to zero). Enter is a big, unmissable key for a navigation reset."}
    {keys r,           action 1013,   desc "Toggle recording",
     mnemonic "R for Record",
     why "First-letter mnemonic; single unmodified key because record needs to be instant when tracking."}
    {keys ",",         action 40172,  desc "Go to previous marker",
     mnemonic "< points left",
     why "Comma and period carry < and > on the keycaps — the arrows literally point at previous/next. Same convention as frame-stepping in video editors."}
    {keys ".",         action 40173,  desc "Go to next marker",
     mnemonic "> points right"}
)
