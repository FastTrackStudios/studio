// MIDI editor mode switching — the MIDI-editor analogue of the session
// modes in modes.styx. Switching into a MIDI mode (e.g. Drums) sets up the
// editor view and loads that mode's MIDI keybinds.
//
// These are global + `passthrough true` so they fire everywhere, including
// while the MIDI editor is focused (the mode-switch actions are main-section
// FTS actions; without passthrough a plain global key is handed to the
// editor's native handling instead of running).

bindings (
    {keys "<A-S-d>", action FTS_MIDI_MODE_DRUMS, passthrough true, desc "MIDI Mode: Drums"}
)

which_key (
    {
        prefix "<A-S-m>",
        label "MIDI Mode",
        case_insensitive true,
        entries (
            {key d, label "Drums", action FTS_MIDI_MODE_DRUMS}
            {key c, label "Cycle", action FTS_MIDI_MODE_CYCLE}
        )
    }
)
