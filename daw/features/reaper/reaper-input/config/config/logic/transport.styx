bindings (
    {keys "<space>",    action 40044, desc "Play/Stop"}
    {keys "<enter>",    action 40042, desc "Go to start of project"}
    {keys r,            action 1013,  desc "Record"}
    // Numpad transport (Logic style)
    {keys "<kp_enter>",   action 1007,  desc "Play"}
    {keys "<kp_0>",       action 1016,  desc "Stop"}
    {keys "<kp_.>",       action 1008,  desc "Pause"}
    {keys "<kp_*>",       action 40046, desc "Toggle record"}
    // Scrub / nudge
    {keys ",",          action 40084, desc "Rewind a little"}
    {keys ".",          action 40085, desc "Fast forward a little"}
    {keys "/",            action 40222, desc "Go to next measure"}
    // Loop / cycle
    {keys c,            action 1068,  desc "Toggle repeat / cycle"}
    // Metronome
    {keys k,            action 40364, desc "Toggle metronome"}
    {keys "<S-k>",        action 40265, desc "Toggle count-in before recording"}
)
