bindings (
    // Split / delete
    {keys t,            action 40757, desc "Split items at edit cursor"}
    {keys "<delete>",     action 40006, desc "Remove selected items"}
    {keys "<backspace>",  action 40006, desc "Remove selected items"}

    // Clipboard (Cmd-key style)
    {keys "<D-x>",        action 40059, desc "Cut items / tracks / envelope points"}
    {keys "<D-c>",        action 40060, desc "Copy items / tracks / envelope points"}
    {keys "<D-v>",        action 40058, desc "Paste items / tracks"}

    // Undo / redo
    {keys "<D-z>",        action 40029, desc "Undo"}
    {keys "<S-D-z>",      action 40030, desc "Redo"}

    // Selection
    {keys "<D-a>",        action 40182, desc "Select all items"}
    {keys "<D-d>",        action 41295, desc "Duplicate items"}

    // Region manipulation
    {keys l,            action 40636, desc "Toggle loop item source"}
    {keys q,            action 40070, desc "Quantize item positions to grid"}
    {keys "<D-j>",        action 40362, desc "Glue / join items"}

    // Nudging
    {keys "<M-right>",    action 40793, desc "Nudge item position right by grid"}
    {keys "<M-left>",     action 40794, desc "Nudge item position left by grid"}
    {keys "<M-S-right>",  action 40228, desc "Nudge item length right"}
    {keys "<M-S-left>",   action 40227, desc "Nudge item length left"}
    {keys ";",          action 41205, desc "Move items to edit cursor"}

    // Item edges
    {keys "<D-[>",        action 41311, desc "Set item start to edit cursor"}
    {keys "<D-]>",        action 41312, desc "Set item end to edit cursor"}

    // Shuffle / arrangement
    {keys "<M-[>",        action 41120, desc "Shuffle items left"}
    {keys "<M-]>",        action 41121, desc "Shuffle items right"}

    // Track management
    {keys "<M-D-n>",      action 40001, desc "Insert new track"}
    {keys "<D-delete>",   action 40005, desc "Delete / remove tracks"}

    // Mute region
    {keys "<C-m>",        action 40719, desc "Mute selected items"}

    // Reverse
    {keys "<C-S-r>",      action 41051, desc "Reverse items"}
)
