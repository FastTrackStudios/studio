bindings (
    // Selection
    {keys "<D-a>",        action 40003, context @Midi, desc "Select all notes"}
    {keys "<escape>",     action 40214, context @Midi, desc "Unselect all"}

    // Note movement (Option+Arrow — Logic style)
    {keys "<M-up>",       action 40138, context @Midi, desc "Move notes up one semitone"}
    {keys "<M-down>",     action 40139, context @Midi, desc "Move notes down one semitone"}
    {keys "<M-S-up>",     action 40140, context @Midi, desc "Move notes up one octave"}
    {keys "<M-S-down>",   action 40141, context @Midi, desc "Move notes down one octave"}

    // Editing
    {keys "<delete>",     action 40002, context @Midi, desc "Delete notes"}
    {keys "<backspace>",  action 40002, context @Midi, desc "Delete notes"}
    {keys "<D-c>",        action 40010, context @Midi, desc "Copy notes"}
    {keys "<D-x>",        action 40011, context @Midi, desc "Cut notes"}
    {keys "<D-v>",        action 40012, context @Midi, desc "Paste notes"}
    {keys "<D-d>",        action 40006, context @Midi, desc "Duplicate notes"}

    // Quantize
    {keys q,            action 40039, context @Midi, desc "Quantize notes to grid"}

    // Velocity (Logic style)
    {keys "<M-C-up>",     action 40462, context @Midi, desc "Increase velocity"}
    {keys "<M-C-down>",   action 40463, context @Midi, desc "Decrease velocity"}

    // Length
    {keys "<S-\\>",     action 40443, context @Midi, desc "Force legato (stretch to next note)"}
    {keys "\\",         action 40444, context @Midi, desc "Remove overlap"}

    // Zoom (Cmd+Arrow — Logic style)
    {keys "<D-right>",    action 40111, context @Midi, desc "Zoom in horizontal"}
    {keys "<D-left>",     action 40112, context @Midi, desc "Zoom out horizontal"}
    {keys "<D-up>",       action 40113, context @Midi, desc "Zoom in vertical"}
    {keys "<D-down>",     action 40114, context @Midi, desc "Zoom out vertical"}

    // Tools (Logic style)
    {keys t,            action 40042, context @Midi, desc "Pointer tool"}
    {keys p,            action 40044, context @Midi, desc "Pencil tool"}
    {keys e,            action 40043, context @Midi, desc "Eraser tool"}
)

wheel (
    // Vertical scroll
    {modifiers "",      action 40432, context @Midi, desc "Scroll view vertically"}
    // Horizontal scroll
    {modifiers "<S->",    action 40433, context @Midi, desc "Scroll horizontally (Shift+wheel)"}
    // Zoom wheel bindings live in the scroll-zoom workflow.
)
