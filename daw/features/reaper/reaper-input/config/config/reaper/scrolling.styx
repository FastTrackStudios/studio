bindings (
    // Horizontal zoom
    {keys "<plus>",       action 1012,  desc "Zoom in horizontal"}
    {keys "=",            action 1012,  desc "Zoom in horizontal (=)"}
    {keys "<minus>",      action 1011,  desc "Zoom out horizontal"}
    {keys "<kp_+>",       action 1012,  desc "Zoom in horizontal (numpad)"}
    {keys "<kp_->",       action 1011,  desc "Zoom out horizontal (numpad)"}

    // Vertical zoom
    {keys "<S-plus>",     action 40111, desc "Zoom in vertical"}
    {keys "<S-=>",        action 40111, desc "Zoom in vertical (=)"}
    {keys "<S-minus>",    action 40112, desc "Zoom out vertical"}

    // Quick zoom
    {keys z,            action 40295, desc "Zoom to fit project in arrange"}

    // View scroll
    {keys "<C-pgup>",     action 40631, desc "Scroll view up"}
    {keys "<C-pgdn>",     action 40630, desc "Scroll view down"}

    // Track height
    {keys "<C-S-up>",     action 40110, desc "Increase track height"}
    {keys "<C-S-down>",   action 40113, desc "Decrease track height"}
)

wheel (
    // Vertical scroll
    {modifiers "",      action 989,   desc "Scroll view vertically"}
    // Horizontal scroll
    {modifiers "<S->",    action 977,   desc "Scroll horizontally reversed (Shift+wheel)"}
    {modifiers "<S->",    action 977,   horizontal true, desc "Scroll horizontally reversed (Shift+horizwheel)"}
    {modifiers "",      action 977,   horizontal true, desc "Scroll horizontally reversed (horizwheel)"}
    // Zoom wheel bindings live in the scroll-zoom workflow.
)
