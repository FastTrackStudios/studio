// Mix mode workflow. id = "mode-mix", name = "Mode Mix".
// See mode-organize.styx for the override-block menu pattern.

name        "Mix"
description "Mixer focus, processing, automation."

bindings (
    // ── Mix phases (p prefix) ────────────────────────────────────────
    // STAGING → RESCUE → BALANCE → TONE → POLISH → MIX → DEPTH →
    // AUTOMATE → OVERVIEW (docs/mixing-phases.md). Not a strict order —
    // jump as needed. Each phase records itself and applies its
    // visibility rules (BALANCE/TONE = detailed, MIX/OVERVIEW = overview
    // density; the rest pending rule definitions).
    {keys "p s", action "_FTS_SESSION_MIX_PHASE_STAGING",  desc "Phase: Staging (gain)"}
    {keys "p r", action "_FTS_SESSION_MIX_PHASE_RESCUE",   desc "Phase: Rescue EQ"}
    {keys "p b", action "_FTS_SESSION_MIX_PHASE_BALANCE",  desc "Phase: Volume Balance"}
    {keys "p t", action "_FTS_SESSION_MIX_PHASE_TONE",     desc "Phase: Tonal EQ"}
    {keys "p p", action "_FTS_SESSION_MIX_PHASE_POLISH",   desc "Phase: Polish (dynamics)"}
    {keys "p m", action "_FTS_SESSION_MIX_PHASE_MIX",      desc "Phase: Mix (relational EQ)"}
    {keys "p d", action "_FTS_SESSION_MIX_PHASE_DEPTH",    desc "Phase: Depth Matrix"}
    {keys "p a", action "_FTS_SESSION_MIX_PHASE_AUTOMATE", desc "Phase: Automation"}
    {keys "p o", action "_FTS_SESSION_MIX_PHASE_OVERVIEW", desc "Phase: Overview (mix bus)"}
)
